      "panel-5": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "Заявки по статусам и приоритетам",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "P4057F4E2305F1D65"
                      },
                      "spec": {
                        "dataset": "maintenance_service",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\r\n    CASE r.status\r\n        WHEN 'new' THEN 'Новые'\r\n        WHEN 'in_progress' THEN 'В работе'\r\n        WHEN 'done' THEN 'Выполнено'\r\n        WHEN 'rejected' THEN 'Отклонено'\r\n        ELSE r.status\r\n    END AS \"Статус\",\r\n    CASE r.priority\r\n        WHEN 'critical' THEN 'Критический'\r\n        WHEN 'high' THEN 'Высокий'\r\n        WHEN 'medium' THEN 'Средний'\r\n        WHEN 'low' THEN 'Низкий'\r\n        ELSE r.priority\r\n    END AS \"Приоритет\",\r\n    COUNT(*) AS \"Количество\"\r\nFROM maintenance_requests r\r\nGROUP BY r.status, r.priority\r\nORDER BY r.status, r.priority;",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
