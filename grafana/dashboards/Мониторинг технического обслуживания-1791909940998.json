                        "rawSql": "SELECT\r\n    CASE priority\r\n        WHEN 'critical' THEN 'Критический'\r\n        WHEN 'high' THEN 'Высокий'\r\n        WHEN 'medium' THEN 'Средний'\r\n        WHEN 'low' THEN 'Низкий'\r\n        ELSE priority\r\n    END AS \"Приоритет\",\r\n    COUNT(*) AS \"Количество\"\r\nFROM maintenance_requests\r\nGROUP BY priority\r\nORDER BY\r\n    CASE priority\r\n        WHEN 'critical' THEN 1\r\n        WHEN 'high' THEN 2\r\n        WHEN 'medium' THEN 3\r\n        WHEN 'low' THEN 4\r\n        ELSE 5\r\n    END;",
