      "panel-6": {
        "kind": "Panel",
        "spec": {
          "id": 6,
          "title": "Среднее время закрытия заявок",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "P4057F4E2305F1D65"
                      },
                      "spec": {
                        "dataset": "maintenance_service",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "WITH started AS (\r\n    SELECT\r\n        request_id,\r\n        MIN(created_at) AS started_at\r\n    FROM request_status_history\r\n    WHERE new_status = 'in_progress'\r\n    GROUP BY request_id\r\n),\r\nfinished AS (\r\n    SELECT\r\n        h.request_id,\r\n        MIN(h.created_at) AS finished_at\r\n    FROM request_status_history h\r\n    JOIN started s ON s.request_id = h.request_id\r\n    WHERE h.new_status = 'done'\r\n      AND h.created_at >= s.started_at\r\n    GROUP BY h.request_id\r\n)\r\nSELECT\r\n    ROUND(\r\n        AVG(EXTRACT(EPOCH FROM (f.finished_at - s.started_at)) / 3600)::numeric,\r\n        2\r\n    ) AS \"Среднее время закрытия, ч\"\r\nFROM started s\r\nJOIN finished f ON f.request_id = s.request_id;",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        }
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
